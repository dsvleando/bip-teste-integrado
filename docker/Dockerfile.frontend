FROM node:20-alpine AS builder

ARG API_URL=/api/v1

WORKDIR /app

COPY frontend/package*.json ./

RUN npm ci

COPY frontend/ .

RUN npm run build

RUN cp public/env.template.js dist/frontend-app/browser/env.js && \
    sed -i "s|__API_URL__|${API_URL}|g" dist/frontend-app/browser/env.js

FROM nginx:alpine

RUN apk add --no-cache gettext

COPY --from=builder /app/dist/frontend-app/browser /usr/share/nginx/html

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf.template
COPY docker/frontend-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]


